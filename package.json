{
  "name": "shinsa-monorepo",
  "license": "AGPL-3.0-only",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types && effect-tsgo tsc --noEmit -p tsconfig.json",
    "deps": "sherif -i @types/node",
    "dev": "turbo run dev --filter=!@shinsa/desktop",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "knip": "knip",
    "lint": "bun lint:oxlint && bun lint:html && bun lint:styles && bun lint:conventions && bun lint:spelling && bun lint:changelog",
    "lint:changelog": "bun scripts/changelog.ts check --base origin/main",
    "lint:conventions": "bun scripts/lint-conventions.ts --base origin/main",
    "lint:html": "bun scripts/lint-html.ts",
    "lint:oxlint": "effect-tsgo oxlint --type-aware --report-unused-disable-directives",
    "lint:spelling": "cspell --no-progress --no-summary --locale en-GB,en-US \"apps/*/src/**/*.{ts,tsx}\" \"packages/*/src/**/*.{ts,tsx}\" \"docs/*.md\" \"*.md\" \"apps/*/*.md\" \"packages/*/*.md\" \".claude/skills/**/*.md\" \"apps/engine/plugin/**/*.md\" \".changes/*.md\"",
    "lint:styles": "stylelint \"**/*.css\"",
    "prepare": "husky",
    "sandbox": "bun run --cwd apps/web build && bun run --cwd apps/web build:remote && bun scripts/sandbox.ts",
    "seed": "bun scripts/seed.ts",
    "start": "bun run --cwd apps/engine start",
    "test": "turbo run test test:scripts",
    "test:scripts": "bun test --randomize"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.5",
    "@effect/platform-bun": "4.1.1",
    "@effect/sql-sqlite-bun": "4.1.1",
    "@effect/tsgo": "0.63.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.0.0",
    "cspell": "10.4.0",
    "effect": "4.1.1",
    "husky": "9.1.7",
    "knip": "^6.35.1",
    "lint-staged": "16.4.0",
    "oxc-parser": "0.154.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "sherif": "^1.13.0",
    "stylelint": "17.16.0",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.1.1"
  },
  "engines": {
    "node": ">=22.22"
  },
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "effect-tsgo oxlint --type-aware --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.css": [
      "stylelint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc}": "oxfmt --no-error-on-unmatched-pattern",
    "*.html": "bun scripts/lint-html.ts"
  }
}
