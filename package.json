{
  "name": "shinsa-monorepo",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types && tsc --noEmit -p tsconfig.json",
    "deps": "sherif -i @types/node",
    "dev": "turbo run dev",
    "format": "biome check .",
    "format:fix": "biome check . --write",
    "knip": "knip",
    "lint": "biome check . && bun lint:conventions",
    "lint:conventions": "bun scripts/lint-conventions.ts",
    "prepare": "husky",
    "seed": "bun scripts/seed.ts",
    "start": "bun run --cwd apps/cli start",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.5",
    "@biomejs/biome": "2.5.9",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.0.0",
    "husky": "9.1.7",
    "knip": "^6.35.1",
    "lint-staged": "16.4.0",
    "sherif": "^1.13.0",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.22"
  },
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc,css}": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  }
}
