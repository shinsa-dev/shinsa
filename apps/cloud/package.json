{
  "name": "@shinsa/cloud",
  "license": "MIT",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run --cwd ../web build:remote",
    "check-types": "effect-tsgo tsc --noEmit",
    "deploy": "bun run build && wrangler deploy",
    "dev:worker": "bun run --cwd ../web build:remote && wrangler dev --port 5183",
    "migrate": "wrangler d1 migrations apply shinsa-cloud --remote",
    "test": "bun test --randomize"
  },
  "dependencies": {
    "@effect/sql-d1": "4.1.1",
    "@shinsa/core": "workspace:*",
    "effect": "4.1.1"
  },
  "devDependencies": {
    "@effect/sql-sqlite-bun": "4.1.1",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.153.0"
  }
}
