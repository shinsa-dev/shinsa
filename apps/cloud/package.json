{
  "name": "@shinsa/cloud",
  "license": "MIT",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "dev:worker": "bun run --cwd ../web build:remote && wrangler dev --port 5183",
    "migrate": "wrangler d1 migrations apply shinsa-cloud --remote",
    "test": "bun test --randomize"
  },
  "dependencies": {
    "@shinsa/core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.153.0"
  }
}
