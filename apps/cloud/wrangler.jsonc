{
  "name": "shinsa-cloud",
  "account_id": "e8563b02f2bf2b6a136f2781445a486f",
  "compatibility_date": "2026-10-01",
  "main": "./src/index.ts",
  "assets": {
    "directory": "../web/dist-remote",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "app.shinsa.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    { "binding": "DB", "database_name": "shinsa-cloud", "database_id": "", "migrations_dir": "migrations" }
  ],
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "e8563b02f2bf2b6a136f2781445a486f",
    "TUNNEL_ZONE": "shinsa.dev",
    "ALLOWED_GITHUB_LOGINS": ""
  }
}
