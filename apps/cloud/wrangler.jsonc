{
  "name": "shinsa-cloud",
  "account_id": "e8563b02f2bf2b6a136f2781445a486f",
  "compatibility_date": "2026-10-01",
  "main": "./src/index.ts",
  "assets": {
    "directory": "../web/dist-remote",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "shinsa.dev/app", "zone_name": "shinsa.dev" },
    { "pattern": "shinsa.dev/app/*", "zone_name": "shinsa.dev" }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shinsa-cloud",
      "database_id": "a0f0f8e6-5221-425b-af96-918f8dfeb719",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "e8563b02f2bf2b6a136f2781445a486f",
    "TUNNEL_ZONE": "shinsa.dev"
  }
}
