#!/bin/sh
if [ -n "$FAKE_CSWAP_LIST" ] && [ "$1" = "list" ]; then cat "$FAKE_CSWAP_LIST"; exit 0; fi
if [ -n "$FAKE_CSWAP_EXPORT" ] && [ "$1" = "export" ]; then cat "$FAKE_CSWAP_EXPORT"; exit 0; fi
if [ "$1" = "list" ]; then echo '{"accounts": []}'; exit 0; fi
echo "claude-swap is not set up" >&2
exit 1
