#!/usr/bin/env bun
import { appendFileSync, existsSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';

type Json = Record<string, unknown>;

const dir = Bun.env.EUNOE_DIR ?? '';

function readJson(name: string): Json {
  const path = join(dir, name);
  return existsSync(path) ? (JSON.parse(readFileSync(path, 'utf8')) as Json) : {};
}

function register() {
  const registry = Bun.env.FAKE_EUNOE_REGISTRY;
  if (!registry) return;
  const entry = join(registry, String(process.pid));
  writeFileSync(entry, Bun.argv.slice(2).join(' '));
  process.on('exit', () => rmSync(entry, { force: true }));
}

async function serve() {
  const behaviour = readJson('fake.json');
  if (typeof behaviour.fail === 'string') {
    console.error(behaviour.fail);
    process.exit(1);
  }
  register();
  if (behaviour.hang === true) {
    setInterval(() => undefined, 60_000);
    return;
  }
  Bun.serve({
    hostname: '127.0.0.1',
    port: Number(readJson('config.json').port),
    fetch: async (request) => {
      const url = new URL(request.url);
      const config = readJson('config.json');
      if (url.pathname === '/_eunoe/health') {
        return Response.json({ ok: true, version: 'fake', mode: config.mode, pid: process.pid });
      }
      const body = (await request.json().catch(() => ({}))) as Json;
      const session = request.headers.get('x-claude-code-session-id');
      const fold = typeof body.fold === 'string' ? body.fold : null;
      appendFileSync(
        join(dir, 'requests.jsonl'),
        `${JSON.stringify({
          ts: new Date().toISOString(),
          path: url.pathname,
          status: 200,
          thread: session ? `${session}-fingerprint` : null,
          action: 'compact',
          compacted: fold !== null,
          ...(fold ? { actions: [fold] } : {}),
          mode: config.mode,
        })}\n`
      );
      return Response.json({ mode: config.mode, authorization: request.headers.get('authorization') });
    },
  });
}

if (Bun.argv[2] === 'serve') await serve();
else console.log('eunoe 0.0.0-fake');
