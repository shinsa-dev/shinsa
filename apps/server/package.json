{
  "name": "@shinsa/server",
  "license": "MIT",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "dev": "bun --watch src/main.ts engine",
    "docs:cli": "bun -e \"import { replaceReference } from './src/cli/help.ts'; const doc = Bun.file('../../docs/cli.md'); await Bun.write(doc, replaceReference(await doc.text()))\"",
    "start": "bun src/main.ts engine",
    "test": "bun test --coverage",
    "test:live": "bun test/live/smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.280",
    "@chroxify/eunoe": "1.2.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@shinsa/core": "workspace:*",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "bin": {
    "shinsa": "src/main.ts"
  }
}
