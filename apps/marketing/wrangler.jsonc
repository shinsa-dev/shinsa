{
  "name": "shinsa-marketing",
  "account_id": "e8563b02f2bf2b6a136f2781445a486f",
  "compatibility_date": "2026-10-01",
  "main": "./src/worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/download", "/download/*"],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "shinsa.dev", "custom_domain": true },
    { "pattern": "www.shinsa.dev", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": true,
  "r2_buckets": [{ "binding": "DOWNLOADS", "bucket_name": "shinsa-releases" }],
  "previews": {
    "r2_buckets": [{ "binding": "DOWNLOADS", "bucket_name": "shinsa-releases" }]
  }
}
