---
import { Logo } from '@shinsa/ui/components/logo';
import { sections } from '../../lib/content';
import { site } from '../../lib/site';
import Button from '../ui/Button.astro';

const links = [
  { label: 'Gates', href: `/#${sections.gates.id}` },
  { label: 'Review', href: `/#${sections.review.id}` },
  { label: 'Code', href: `/#${sections.code.id}` },
  { label: 'Agents', href: `/#${sections.tasks.id}` },
  { label: 'Safety', href: `/#${sections.guard.id}` },
];
---

<header
  class='sticky top-0 z-40 bg-background px-6 after:pointer-events-none after:absolute after:inset-x-0 after:top-full after:h-8 after:bg-linear-to-b after:from-background after:to-transparent after:opacity-0 after:transition-opacity after:duration-300 in-data-scrolled:after:opacity-100'
>
  <div class='mx-auto flex h-14 max-w-5xl items-center gap-6'>
    <a href='/#top' class='flex items-center gap-1.5 font-medium text-fg-4 text-sm' aria-label='Shinsa'>
      <span class='grid size-5 shrink-0 place-items-center'>
        <Logo className='size-3.25' />
      </span>
      Shinsa
    </a>
    <nav class='mx-auto hidden items-center gap-1 md:flex' aria-label='Sections'>
      {
        links.map((link) => (
          <a
            href={link.href}
            class='rounded-control px-2.5 py-1 text-fg-2 text-sm transition-colors duration-150 hover:bg-bg-a1 hover:text-fg-4'
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class='ms-auto flex items-center gap-1.5 md:ms-0'>
      <Button href={site.githubUrl} variant='secondary' icon='IconGithub' external class='max-sm:hidden'>GitHub</Button>
      <Button href={site.downloadUrl}>Download</Button>
    </div>
  </div>
</header>
