---
import type { SectionCopy } from '../../lib/content';

interface Props {
  copy: SectionCopy;
}

const { copy } = Astro.props;
---

<section
  id={copy.id}
  data-scene={copy.id}
  class='flex flex-col px-6 py-12 md:py-16'
>
  <div class='mx-auto flex max-w-2xl flex-col items-center gap-3 text-center'>
    <h2 class='font-medium text-2xl text-fg-4 tracking-tight text-balance md:text-3xl'>{copy.title}</h2>
    <p class='text-base text-fg-2 leading-relaxed text-pretty'>{copy.text}</p>
  </div>
  <div class='@container mx-auto mt-8 w-full max-w-5xl md:mt-10' data-chip>
    <slot />
  </div>
</section>
