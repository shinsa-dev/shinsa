---
import { Icon } from '@shinsa/ui/components/icon';
import { closing, features, hero, principles } from '../../lib/content';
import { site } from '../../lib/site';
import Button from '../ui/Button.astro';
---

<section
  id='start'
  data-scene='start'
  class='flex flex-col px-6 pt-12 pb-20 md:pt-16 md:pb-24'
>
  <div class='mx-auto grid w-full max-w-5xl gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4'>
    {
      principles.map((principle) => (
        <div class='flex flex-col gap-1.5'>
          <h3 class='font-medium text-base text-fg-4'>{principle.title}</h3>
          <p class='text-fg-2 text-sm leading-relaxed text-pretty'>{principle.text}</p>
        </div>
      ))
    }
  </div>
  <div class='mx-auto mt-12 grid w-full max-w-5xl gap-x-10 gap-y-6 border-bg-3 border-t pt-12 sm:grid-cols-2 lg:grid-cols-4'>
    {
      features.map((feature) => (
        <div class='flex flex-col gap-1'>
          <h3 class='flex items-center gap-2 font-medium text-fg-4 text-sm [--icon-size:var(--icon-size-md)]'>
            <span class='text-fg-2'>
              <Icon name={feature.icon} />
            </span>
            {feature.title}
          </h3>
          <p class='text-fg-2 text-sm leading-relaxed text-pretty'>{feature.text}</p>
        </div>
      ))
    }
  </div>
  <div class='mx-auto mt-24 flex max-w-xl flex-col items-center gap-6 text-center'>
    <h2 class='font-medium text-3xl tracking-tight text-balance md:text-4xl'>
      <span class='text-fg-4'>{closing.title}</span>{' '}<span class='text-fg-2'>{closing.text}</span>
    </h2>
    <div class='flex flex-wrap items-center justify-center gap-2'>
      <Button href={site.downloadUrl}>{hero.primary}</Button>
      <Button href={site.githubUrl} variant='secondary' icon='IconGithub' external>{hero.secondary}</Button>
    </div>
  </div>
</section>
