---
import { resolveGreeting } from '@/lib/home.ts';
import { hero } from '../../lib/content';
import { site } from '../../lib/site';
import Button from '../ui/Button.astro';

const greetings = Array.from({ length: 24 }, (_, hour) =>
  resolveGreeting(new Date(2026, 0, 1, hour).getTime())
);
---

<section id='top' data-scene='top' class='flex flex-col px-6 pt-16 pb-6 md:pt-24 md:pb-10'>
  <div class='mx-auto flex max-w-2xl flex-col items-center gap-5 text-center'>
    <h1 class='font-medium text-4xl text-fg-4 leading-[1.08] tracking-tight text-balance md:text-5xl'>
      {hero.headline}
    </h1>
    <p class='max-w-xl text-base text-fg-2 leading-relaxed text-pretty md:text-lg'>{hero.text}</p>
    <div class='mt-2 flex flex-wrap items-center justify-center gap-2'>
      <Button href={site.downloadUrl}>{hero.primary}</Button>
      <Button href={site.githubUrl} variant='secondary' icon='IconGithub' external>{hero.secondary}</Button>
    </div>
  </div>
  <div class='@container mx-auto mt-12 w-full max-w-5xl md:mt-16' data-chip>
    <slot />
  </div>
  <script is:inline define:vars={{ greetings }}>
    const greeting = document.querySelector('#top [data-chip] h1');
    const text = greetings[new Date().getHours()];
    if (greeting && text && greeting.textContent !== text) greeting.textContent = text;
  </script>
</section>
