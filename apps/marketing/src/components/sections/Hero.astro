---
import { resolveGreeting } from '@/lib/home.ts';
import { Icon } from '@shinsa/ui/components/icon';
import { hero, koe } from '../../lib/content';
import { koeSite, site } from '../../lib/site';
import Button from '../ui/Button.astro';

const greetings = Array.from({ length: 24 }, (_, hour) =>
  resolveGreeting(new Date(2026, 0, 1, hour).getTime())
);
---

<section id='top' data-scene='top' class='flex flex-col px-6 pt-16 pb-6 md:pt-24 md:pb-10'>
  <div class='mx-auto flex max-w-2xl flex-col items-center gap-5 text-center'>
    <a
      href={koeSite.path}
      class='flex h-7 items-center gap-2 rounded-full bg-background ps-1 pe-2.5 text-fg-3 text-sm ring-1 ring-bg-3 transition-colors duration-150 hover:bg-bg-a1 hover:text-fg-4'
    >
      <span class='rounded-full bg-primary-a2 px-2 py-0.5 font-medium text-primary text-xs'>{koe.launchTag}</span>
      <img src='/koe/koe.svg' alt='' width='16' height='16' class='size-4' />
      {koe.launchText}
      <Icon name='IconChevronRightMedium' size='sm' className='text-fg-2' />
    </a>
    <h1 class='font-medium text-4xl leading-[1.08] tracking-tight text-balance md:text-5xl'>
      <span class='text-fg-4'>{hero.headline}</span>{' '}<span class='text-fg-2'>{hero.headlineRest}</span>
    </h1>
    <p class='max-w-[38rem] text-base text-fg-2 leading-relaxed text-pretty md:text-lg'>{hero.text}</p>
    <div class='mt-2 flex flex-wrap items-center justify-center gap-2'>
      <Button href={site.canaryUrl}>{hero.primary}</Button>
      <Button href={site.githubUrl} variant='secondary' icon='IconGithub' iconSize='md' external>{hero.secondary}</Button>
    </div>
  </div>
  <div class='@container mx-auto mt-12 w-full max-w-5xl md:mt-16' data-chip>
    <slot />
  </div>
  <script is:inline define:vars={{ greetings }}>
    const greeting = document.querySelector('#top [data-chip] h1');
    const text = greetings[new Date().getHours()];
    if (greeting && text && greeting.textContent !== text) greeting.textContent = text;
  </script>
</section>
