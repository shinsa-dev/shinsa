---
import { OpenLoading, OpenReview } from '../components/demos/open-review';
import Site from '../layouts/Site.astro';
import { site } from '../lib/site';
---

<Site title='Open a task · Shinsa' description={site.description} noindex>
  <div class='flex h-[calc(100dvh-3.5rem)] min-h-0 flex-col'>
    <OpenReview client:only='react'>
      <OpenLoading slot='fallback' />
    </OpenReview>
  </div>
</Site>
