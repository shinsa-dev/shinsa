---
import Button from '../../components/ui/Button.astro';
import Site from '../../layouts/Site.astro';
import { site } from '../../lib/site';
---

<Site title='Download not available · Shinsa' description={site.description} noindex>
  <section class='flex min-h-[60svh] flex-col items-center justify-center gap-4 px-6 py-24 text-center'>
    <h1 class='font-medium text-3xl text-fg-4 tracking-tight'>The download is not available right now.</h1>
    <p class='max-w-md text-fg-2'>
      Shinsa's releases are kept on GitHub, and the file could not be reached. Try again in a few minutes, or take it
      from the releases page.
    </p>
    <div class='flex flex-wrap justify-center gap-2'>
      <Button href={`${site.githubUrl}/releases`} external>Open the releases page</Button>
      <Button href='/' variant='outline'>Go to the home page</Button>
    </div>
  </section>
</Site>
