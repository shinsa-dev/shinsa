---
import Button from '../../components/ui/Button.astro';
import Site from '../../layouts/Site.astro';
import { site } from '../../lib/site';
---

<Site title='No stable release yet · Shinsa' description={site.description} noindex>
  <section class='flex min-h-[60svh] flex-col items-center justify-center gap-4 px-6 py-24 text-center'>
    <h1 class='font-medium text-3xl text-fg-4 tracking-tight'>There is no stable release yet.</h1>
    <p class='max-w-md text-fg-2'>
      Shinsa is in beta for now. The beta updates itself to each stable release once there is one.
    </p>
    <div class='flex flex-wrap justify-center gap-2'>
      <Button href={site.betaUrl}>Download the beta</Button>
      <Button href={`${site.githubUrl}/releases`} variant='outline' external>See every release</Button>
    </div>
  </section>
</Site>
