#!/usr/bin/env bun
import { existsSync, mkdirSync, readFileSync, renameSync, rmSync, statSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';

interface FakeCheckRun {
  name: string;
  status: string;
  conclusion: string | null;
  required: boolean;
}

interface FakeComment {
  id: string;
  author: string | null;
  createdAt: string;
  body: string;
}

interface FakePullRequest {
  number: number;
  head: string;
  base: string;
  title: string;
  state: 'OPEN' | 'MERGED' | 'CLOSED';
  checks: 'pending' | 'passing' | 'failing' | 'none';
  mergeable: 'MERGEABLE' | 'CONFLICTING' | 'UNKNOWN';
  unresolved: number;
  mergedWith: string | null;
  mergeCommit?: string | null;
  reviewDecision?: string | null;
  checkRuns?: FakeCheckRun[];
  comments?: FakeComment[];
  queue?: { state: string; position: number | null } | null;
  queueRemoval?: string | null;
}

interface FakeState {
  next: number;
  defaultChecks: FakePullRequest['checks'];
  pulls: FakePullRequest[];
  calls: string[][];
  mergeQueue?: boolean;
  failReads?: number;
  workflows?: Record<string, string>;
  requiredChecks?: string[];
  rulesetChecks?: string[];
  baseChecks?: boolean;
}

const path = Bun.env.FAKE_GH_STATE || '/dev/null';
const lock = `${path}.lock`;
const LOCK_STALE_MS = 10_000;
const LOCK_DEADLINE_MS = 20_000;

function isStaleLock() {
  try {
    const holder = Number(readFileSync(join(lock, 'pid'), 'utf8'));
    process.kill(holder, 0);
    return false;
  } catch (error) {
    if ((error as NodeJS.ErrnoException).code === 'ESRCH') return true;
  }
  try {
    return Date.now() - statSync(lock).mtimeMs > LOCK_STALE_MS;
  } catch {
    return false;
  }
}

function takeLock() {
  const deadline = Date.now() + LOCK_DEADLINE_MS;
  for (;;) {
    try {
      mkdirSync(lock);
      writeFileSync(join(lock, 'pid'), String(process.pid));
      return;
    } catch (error) {
      if ((error as NodeJS.ErrnoException).code !== 'EEXIST') {
        console.error(`fake gh: cannot lock ${path}: ${(error as Error).message}`);
        process.exit(2);
      }
    }
    if (isStaleLock()) rmSync(lock, { recursive: true, force: true });
    if (Date.now() > deadline) {
      console.error(`fake gh: ${path} stayed locked`);
      process.exit(2);
    }
    Bun.sleepSync(2);
  }
}

const registry = Bun.env.FAKE_GH_REGISTRY;
if (registry) {
  const entry = join(registry, String(process.pid));
  writeFileSync(entry, Bun.argv.slice(2).join(' '));
  process.on('exit', () => rmSync(entry, { force: true }));
}

if (path !== '/dev/null') {
  takeLock();
  process.on('exit', () => rmSync(lock, { recursive: true, force: true }));
}
const state: FakeState = path !== '/dev/null' && existsSync(path)
  ? JSON.parse(readFileSync(path, 'utf8'))
  : { next: 1, defaultChecks: 'pending', pulls: [], calls: [] };
const args = Bun.argv.slice(2);
state.calls.push(args);

function save() {
  if (path === '/dev/null') return;
  writeFileSync(`${path}.tmp`, JSON.stringify(state, null, 2));
  renameSync(`${path}.tmp`, path);
}

function flag(name: string) {
  const index = args.indexOf(name);
  return index === -1 ? null : (args[index + 1] ?? null);
}

function find(target: string | undefined) {
  if (!target) return undefined;
  return state.pulls.find((pull) => String(pull.number) === target || pull.head === target);
}

function rollup(checks: FakePullRequest['checks']) {
  if (checks === 'none') return [];
  const conclusion = checks === 'passing' ? 'SUCCESS' : checks === 'failing' ? 'FAILURE' : '';
  return [{ __typename: 'CheckRun', status: checks === 'pending' ? 'IN_PROGRESS' : 'COMPLETED', conclusion }];
}

function headSha(branch: string) {
  const result = Bun.spawnSync(['git', 'rev-parse', `refs/heads/${branch}`], { cwd: Bun.env.FAKE_GH_ORIGIN ?? '.' });
  return result.exitCode === 0 ? result.stdout.toString().trim() : null;
}

function contexts(pull: FakePullRequest) {
  const runs: FakeCheckRun[] =
    pull.checkRuns ??
    (pull.checks === 'none'
      ? []
      : [
          {
            name: 'ci',
            status: pull.checks === 'pending' ? 'IN_PROGRESS' : 'COMPLETED',
            conclusion: pull.checks === 'passing' ? 'SUCCESS' : pull.checks === 'failing' ? 'FAILURE' : null,
            required: false,
          },
        ]);
  return runs.map((run) => ({
    __typename: 'CheckRun',
    name: run.name,
    status: run.status,
    conclusion: run.conclusion,
    detailsUrl: `https://github.com/acme/app/actions/${run.name}`,
    isRequired: run.required,
  }));
}

function comment(entry: FakeComment) {
  return {
    id: entry.id,
    author: entry.author === null ? null : { login: entry.author },
    createdAt: entry.createdAt,
    lastEditedAt: null,
    body: entry.body,
    url: `https://github.com/acme/app/pull/comment/${entry.id}`,
  };
}

function details(pull: FakePullRequest) {
  const threads = Array.from({ length: pull.unresolved }, (_, index) => ({
    id: `thread-${pull.number}-${index}`,
    isResolved: false,
    isOutdated: false,
    path: 'app.ts',
    comments: {
      totalCount: 1,
      nodes: [
        comment({
          id: `thread-comment-${pull.number}-${index}`,
          author: 'reviewer',
          createdAt: '2026-01-01T00:00:00Z',
          body: 'Please fix this.',
        }),
      ],
    },
  }));
  const comments = pull.comments ?? [];
  return {
    viewer: { login: Bun.env.FAKE_GH_LOGIN || 'shinsa-user' },
    repository: {
      pullRequest: {
        author: { login: 'shinsa-user' },
        mergeQueueEntry: pull.queue ?? null,
        autoMergeRequest: null,
        commits: { nodes: [{ commit: { statusCheckRollup: { contexts: { nodes: contexts(pull) } } } }] },
        comments: { totalCount: comments.length, nodes: comments.map(comment) },
        reviews: { totalCount: 0, nodes: [] },
        reviewThreads: { totalCount: threads.length, nodes: threads },
        timelineItems: { nodes: pull.queueRemoval ? [{ reason: pull.queueRemoval }] : [] },
      },
    },
  };
}

function failRead() {
  if (!state.failReads) return false;
  state.failReads -= 1;
  save();
  console.error('HTTP 502: Bad Gateway');
  process.exit(1);
}

const [group, command] = args;
if (group === 'pr' && command === 'view') {
  failRead();
  const pull = find(args[2]);
  save();
  if (!pull) {
    console.error('no pull requests found');
    process.exit(1);
  }
  console.log(
    JSON.stringify({
      number: pull.number,
      title: pull.title,
      url: `https://github.com/acme/app/pull/${pull.number}`,
      state: pull.state,
      mergeable: pull.mergeable,
      reviewDecision: pull.reviewDecision ?? null,
      baseRefName: pull.base,
      headRefOid: headSha(pull.head),
      mergeCommit: pull.mergeCommit ? { oid: pull.mergeCommit } : null,
      statusCheckRollup: rollup(pull.checks),
    })
  );
  process.exit(0);
}
if (group === 'pr' && command === 'create') {
  const head = flag('--head') ?? '';
  if (find(head)?.state === 'OPEN') {
    console.error('a pull request already exists');
    process.exit(1);
  }
  const pull: FakePullRequest = {
    number: state.next++,
    head,
    base: flag('--base') ?? 'main',
    title: flag('--title') ?? '',
    state: 'OPEN',
    checks: state.defaultChecks,
    mergeable: 'MERGEABLE',
    unresolved: 0,
    mergedWith: null,
  };
  state.pulls.push(pull);
  save();
  console.log(`https://github.com/acme/app/pull/${pull.number}`);
  process.exit(0);
}
if (group === 'pr' && command === 'edit') {
  const pull = find(args[2]);
  if (pull) pull.base = flag('--base') ?? pull.base;
  save();
  process.exit(pull ? 0 : 1);
}
if (group === 'pr' && command === 'merge') {
  const pull = find(args[2]);
  if (!pull || pull.state !== 'OPEN') {
    save();
    process.exit(1);
  }
  const match = flag('--match-head-commit');
  if (match && match !== headSha(pull.head)) {
    save();
    console.error('GraphQL: Head branch was modified. Review and try the merge again. (mergePullRequest)');
    process.exit(1);
  }
  if (state.mergeQueue) {
    pull.queue = { state: 'QUEUED', position: 1 };
  } else {
    pull.state = 'MERGED';
    pull.mergeCommit = pull.mergeCommit ?? headSha(pull.head);
  }
  pull.mergedWith = args[3] ?? null;
  save();
  process.exit(0);
}
if (group === 'api' && command === 'graphql' && args.some((arg) => arg.startsWith('workflows='))) {
  save();
  const entries = Object.entries(state.workflows ?? {}).map(([name, text]) => ({ name, object: { text } }));
  console.log(
    JSON.stringify({
      repository: {
        workflows: state.workflows ? { entries } : null,
        base: { statusCheckRollup: state.baseChecks ? { state: 'SUCCESS' } : null },
      },
    })
  );
  process.exit(0);
}
if (group === 'api' && command?.includes('/rules/branches/')) {
  save();
  const rules = (state.rulesetChecks ?? []).map((context) => ({
    type: 'required_status_checks',
    parameters: { required_status_checks: [{ context }] },
  }));
  console.log(JSON.stringify(rules));
  process.exit(0);
}
if (group === 'api' && command?.includes('/branches/')) {
  save();
  const contexts = state.requiredChecks ?? [];
  console.log(
    JSON.stringify({
      name: command.split('/branches/')[1],
      protection: contexts.length > 0 ? { enabled: true, required_status_checks: { contexts } } : { enabled: false },
    })
  );
  process.exit(0);
}
if (group === 'api' && command === 'graphql') {
  failRead();
  const number = args.find((arg) => arg.startsWith('number='))?.slice('number='.length);
  const pull = find(number);
  save();
  if (!pull) {
    console.error('GraphQL: Could not resolve to a PullRequest');
    process.exit(1);
  }
  console.log(JSON.stringify(details(pull)));
  process.exit(0);
}
if (group === 'api' && command === 'user') {
  save();
  if (!Bun.env.FAKE_GH_LOGIN) process.exit(1);
  console.log(Bun.env.FAKE_GH_LOGIN);
  process.exit(0);
}
save();
console.error(`fake gh: unsupported ${args.join(' ')}`);
process.exit(1);
