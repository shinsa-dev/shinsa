{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["ditto"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "scripts/perf/*.ts", "scripts/seed-media/*.ts", "scripts/screenshots/*.ts"]
    },
    "apps/web": {
      "entry": ["test/**/*.test.{ts,tsx}"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "packages/ui": {
      "entry": ["src/**/*.{ts,tsx}"]
    },
    "apps/desktop": {
      "entry": ["src/main/index.ts", "src/preload/index.ts", "test/**/*.test.ts"]
    },
    "apps/engine": {
      "entry": [
        "test/**/*.test.ts",
        "test/e2e/soak/child.ts",
        "test/helpers/mcp/stdio-server.ts",
        "scripts/*.ts"
      ]
    },
    "apps/cloud": {
      "entry": ["test/**/*.test.ts"]
    },
    "apps/marketing": {
      "entry": ["test/**/*.test.ts"],
      "ignoreDependencies": ["@shinsa/web"]
    }
  }
}
