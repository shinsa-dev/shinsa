{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts",
        "scripts/perf/*.ts",
        "scripts/autopilot/benchmark.ts",
        "scripts/seed-media/*.ts",
        "scripts/screenshots/*.ts",
        "scripts/sandbox/dev-server.ts"
      ],
      "ignoreDependencies": ["@effect/language-service", "oxlint", "oxlint-tsgolint"]
    },
    "apps/web": {
      "entry": ["test/**/*.test.{ts,tsx}", "src/remote-sw.ts"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "packages/ui": {
      "entry": ["src/**/*.{ts,tsx}"]
    },
    "apps/desktop": {
      "entry": ["src/main/index.ts", "src/preload/index.ts", "test/**/*.test.ts"]
    },
    "apps/engine": {
      "entry": [
        "test/**/*.test.ts",
        "test/e2e/soak/child.ts",
        "test/helpers/mcp/stdio-server.ts",
        "scripts/*.ts",
        "npm/shinsa.js"
      ]
    },
    "apps/cloud": {
      "entry": ["test/**/*.test.ts", "src/relay/worker.ts"]
    },
    "apps/marketing": {
      "entry": ["test/**/*.test.ts"],
      "ignoreDependencies": ["@shinsa/web"]
    }
  }
}
